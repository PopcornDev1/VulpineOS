     return rv;
 }
 
+SECStatus
+SSL_SetIdentity(PRFileDesc *fd, const char *identityJSON)
+{
+    sslSocket *ss;
+    ss = ssl_FindSocket(fd);
+    if (!ss) {
+        PORT_SetError(SEC_ERROR_INVALID_ARGS);
+        return SECFailure;
+    }
+    /* Free any existing identity blob */
+    if (ss->identityBlob) {
+        PORT_Free(ss->identityBlob);
+    }
+    /* Copy the identity JSON string */
+    ss->identityBlob = PORT_Strdup(identityJSON);
+    if (!ss->identityBlob) {
+        PORT_SetError(SEC_ERROR_NO_MEMORY);
+        return SECFailure;
+    }
+    return SECSuccess;
+}
+
