+/* vulpine-networklab: set identity-driven extension filter/order */
+SECStatus
+SSLExp_IdentityExtensionOrderSet(PRFileDesc *fd, const PRUint16 *extensions,
+                                 unsigned int count)
+{
+    if (!fd || !extensions || !count) {
+        PORT_SetError(SEC_ERROR_INVALID_ARGS);
+        return SECFailure;
+    }
+    sslSocket *ss = ssl_FindSocket(fd);
+    if (!ss) {
+        SSL_DBG(("%d: SSL[%d]: bad socket in IdentityExtensionOrderSet",
+                 SSL_GETPID(), fd));
+        return SECFailure;
+    }
+    PRUint16 *copy = (PRUint16 *)PORT_Alloc(count * sizeof(PRUint16));
+    if (!copy) {
+        return SECFailure;
+    }
+    PORT_Memcpy(copy, extensions, count * sizeof(PRUint16));
+    ssl_Get1stHandshakeLock(ss);
+    ssl_GetSSL3HandshakeLock(ss);
+    PORT_Free(ss->identityExtOrder);
+    ss->identityExtOrder = copy;
+    ss->identityExtCount = count;
+    ssl_ReleaseSSL3HandshakeLock(ss);
+    ssl_Release1stHandshakeLock(ss);
+    return SECSuccess;
+}
