diff --git a/security/nss/lib/ssl/ssl3ext.c b/security/nss/lib/ssl/ssl3ext.c
index 30b6289da7..6890f7bb82 100644
--- a/security/nss/lib/ssl/ssl3ext.c
+++ b/security/nss/lib/ssl/ssl3ext.c
@@ -876,6 +876,62 @@ ssl_ConstructExtensions(sslSocket *ss, sslBuffer *buf, SSLHandshakeType message)
         goto loser;
     }
 
+    /* vulpine-networklab: reorder extensions per identity
+     * Parse the built extension buffer and reorder entries to match
+     * the identity's extension order list. Entries not in the identity
+     * list are dropped. Types in the identity list not found in the
+     * buffer are silently skipped. */
+    if (ss->identityExtCount > 0 && ss->identityExtOrder && buf->len > 0) {
+        /* Parse buffer into entries */
+        unsigned int entryCount = 0;
+        struct { PRUint16 type; unsigned int offset; unsigned int length; } entries[64];
+        unsigned int pos = 0;
+        while (pos + 4 <= buf->len && entryCount < 64) {
+            PRUint16 etype = (PRUint16)((buf->buf[pos] << 8) | buf->buf[pos + 1]);
+            unsigned int elen = (unsigned int)((buf->buf[pos + 2] << 8) | buf->buf[pos + 3]);
+            if (pos + 4 + elen > buf->len) break;
+            entries[entryCount].type = etype;
+            entries[entryCount].offset = pos;
+            entries[entryCount].length = 4 + elen;
+            entryCount++;
+            pos += 4 + elen;
+        }
+        /* Build reordered buffer */
+        PRUint8 *newBuf = (PRUint8 *)PORT_Alloc(buf->len);
+        if (newBuf) {
+            unsigned int newPos = 0;
+            PRBool used[64];
+            PORT_Memset(used, 0, sizeof(used));
+            for (unsigned int i = 0; i < ss->identityExtCount; i++) {
+                PRUint16 wantType = ss->identityExtOrder[i];
+                for (unsigned int j = 0; j < entryCount; j++) {
+                    if (!used[j] && entries[j].type == wantType) {
+                        PORT_Memcpy(newBuf + newPos,
+                                    buf->buf + entries[j].offset,
+                                    entries[j].length);
+                        newPos += entries[j].length;
+                        used[j] = PR_TRUE;
+                        break;
+                    }
+                }
+            }
+            /* Add any remaining unused extensions at the end */
+            for (unsigned int j = 0; j < entryCount; j++) {
+                if (!used[j]) {
+                    PORT_Memcpy(newBuf + newPos,
+                                buf->buf + entries[j].offset,
+                                entries[j].length);
+                    newPos += entries[j].length;
+                    used[j] = PR_TRUE;
+                }
+            }
+            PORT_Free(buf->buf);
+            buf->buf = newBuf;
+            buf->len = newPos;
+            buf->space = buf->len;
+        }
+    }
+
     return SECSuccess;
 
