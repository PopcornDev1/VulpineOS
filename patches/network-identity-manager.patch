+
+extern mozilla::LazyLogModule gPIPNSSLog;
+
+#define SHMEM_PATH ".vulpineos/network-identities.dat"
+#define SHMEM_DEFAULT_SIZE 65536
+#define MAX_IDENTITY_ENTRIES 64
+
+namespace mozilla {
+namespace psm {
+
+char* NetworkIdentityManager::sShmemBase = nullptr;
+size_t NetworkIdentityManager::sShmemSize = 0;
+bool NetworkIdentityManager::sInitialized = false;
+
+nsresult NetworkIdentityManager::Init() {
+  if (sInitialized) {
+    return NS_OK;
+  }
+
+  const char* home = getenv("HOME");
+  if (!home) {
+    MOZ_LOG(gPIPNSSLog, LogLevel::Warning,
+            ("NetworkIdentityManager: no HOME env var"));
+    return NS_ERROR_FAILURE;
+  }
+
+  char dirPath[1024];
+  snprintf(dirPath, sizeof(dirPath), "%s/.vulpineos", home);
+  mkdir(dirPath, 0700);
+
+  char shmemPath[1024];
+  snprintf(shmemPath, sizeof(shmemPath), "%s/%s", home, SHMEM_PATH);
+
+  int fd = open(shmemPath, O_RDWR | O_CREAT, 0600);
+  if (fd < 0) {
+    MOZ_LOG(gPIPNSSLog, LogLevel::Warning,
+            ("NetworkIdentityManager: open failed: %s", shmemPath));
+    return NS_ERROR_FAILURE;
+  }
+
+  struct stat st;
+  if (fstat(fd, &st) < 0) {
+    close(fd);
+    return NS_ERROR_FAILURE;
+  }
+  if (st.st_size < SHMEM_DEFAULT_SIZE) {
+    ftruncate(fd, SHMEM_DEFAULT_SIZE);
+  }
+  sShmemSize = SHMEM_DEFAULT_SIZE;
+
+  sShmemBase = (char*)mmap(nullptr, sShmemSize, PROT_READ, MAP_SHARED, fd, 0);
+  close(fd);
+
+  if (sShmemBase == MAP_FAILED) {
+    sShmemBase = nullptr;
+    MOZ_LOG(gPIPNSSLog, LogLevel::Warning,
+            ("NetworkIdentityManager: mmap failed"));
+    return NS_ERROR_FAILURE;
+  }
+
+  sInitialized = true;
+  MOZ_LOG(gPIPNSSLog, LogLevel::Debug,
+          ("NetworkIdentityManager: initialized (%s)", shmemPath));
+  return NS_OK;
+}
+
+void NetworkIdentityManager::Shutdown() {
+  if (sShmemBase && sInitialized) {
+    munmap(sShmemBase, sShmemSize);
+    sShmemBase = nullptr;
+    sInitialized = false;
+  }
+}
+
+void NetworkIdentityManager::Refresh() {
+  if (!sInitialized) {
+    Init();
+  }
+}
+
+const char* NetworkIdentityManager::GetIdentityForContext(
+    uint64_t contextId) {
+  if (!sInitialized && NS_FAILED(Init())) {
+    return nullptr;
+  }
+  if (!sShmemBase || sShmemSize == 0) {
+    return nullptr;
+  }
+
+  if (sShmemBase[0] != '\0') {
+    return sShmemBase;
+  }
+  return nullptr;
+}
+
+static int ParseHexArray(const char* json, const char* key,
+                         uint32_t* out, int maxCount) {
+  const char* p = strstr(json, key);
+  if (!p) return 0;
+  p = strchr(p, '[');
+  if (!p) return 0;
+  p++;
+  int count = 0;
+  while (*p && *p != ']' && count < maxCount) {
+    while (*p && (*p == ' ' || *p == ',' || *p == '\n' || *p == '\r' || *p == '\t')) p++;
+    if (*p == ']' || !*p) break;
+    if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
+      p += 2;
+      unsigned long v = 0;
+      while (*p) {
+        if (*p >= '0' && *p <= '9') { v = (v << 4) + (*p - '0'); p++; }
+        else if (*p >= 'a' && *p <= 'f') { v = (v << 4) + (*p - 'a' + 10); p++; }
+        else if (*p >= 'A' && *p <= 'F') { v = (v << 4) + (*p - 'A' + 10); p++; }
+        else break;
+      }
+      out[count++] = (uint32_t)v;
+    } else {
+      p++;
+    }
+  }
+  return count;
+}
+
+SECStatus NetworkIdentityManager::ApplyIdentityToSocket(
+    PRFileDesc* fd, uint64_t contextId) {
+  const char* json = GetIdentityForContext(contextId);
+  if (!json) {
+    return SECSuccess;
+  }
+
+  MOZ_LOG(gPIPNSSLog, LogLevel::Debug,
+          ("NetworkIdentityManager: applying identity to socket"));
+
+  uint32_t values[MAX_IDENTITY_ENTRIES];
+
+  int cipherCount = ParseHexArray(json, "cipher_suites", values, MAX_IDENTITY_ENTRIES);
+  if (cipherCount > 0) {
+    const PRUint16* allCiphers = SSL_GetImplementedCiphers();
+    for (int i = 0; allCiphers[i]; i++) {
+      SSL_CipherPrefSet(fd, (PRInt32)allCiphers[i], PR_FALSE);
+    }
+    for (int i = 0; i < cipherCount; i++) {
+      SSL_CipherPrefSet(fd, (PRInt32)values[i], PR_TRUE);
+    }
+    // Set cipher order to match the identity's cipher preference order.
+    // This controls the order ciphers appear in the ClientHello, which is
+    // critical for exact JA3 fingerprint matching.
+    PRUint16 order[MAX_IDENTITY_ENTRIES];
+    for (int i = 0; i < cipherCount; i++) {
+      order[i] = (PRUint16)values[i];
+    }
+    SECStatus rv = SSL_CipherSuiteOrderSet(fd, order, (PRUint16)cipherCount);
+    if (rv != SECSuccess) {
+      MOZ_LOG(gPIPNSSLog, LogLevel::Warning,
+              ("NetworkIdentityManager: SSL_CipherSuiteOrderSet failed"));
+    }
+  }
+
+  int groupCount = ParseHexArray(json, "supported_groups", values, MAX_IDENTITY_ENTRIES);
+  if (groupCount > 0) {
+    SSLNamedGroup groups[MAX_IDENTITY_ENTRIES];
+    for (int i = 0; i < groupCount; i++) {
+      groups[i] = (SSLNamedGroup)values[i];
+    }
+    SSL_NamedGroupConfig(fd, groups, (unsigned int)groupCount);
+  }
+
+  int sigCount = ParseHexArray(json, "sig_algs", values, MAX_IDENTITY_ENTRIES);
+  if (sigCount > 0) {
+    SSLSignatureScheme schemes[MAX_IDENTITY_ENTRIES];
+    for (int i = 0; i < sigCount; i++) {
+      schemes[i] = (SSLSignatureScheme)values[i];
+    }
+    SSL_SignatureSchemePrefSet(fd, schemes, (unsigned int)sigCount);
+  }
+
+  int shareCount = ParseHexArray(json, "key_share_curves", values, MAX_IDENTITY_ENTRIES);
+  if (shareCount > 0) {
+    SSL_SendAdditionalKeyShares(fd, (unsigned int)shareCount);
+  }
+
+  return SECSuccess;
+}
